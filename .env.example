# -------------------------------------------------------------
# VARIABLES DE ENTORNO — ÓPTICA DANNY
# Copiá este archivo como .env.local y completá los valores
# -------------------------------------------------------------

# Firebase Client SDK (Configuración de la consola de Firebase)
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu_proyecto_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id

# Firebase Admin SDK (Para rutas API y servidor)
# En producción (Vercel): pegar el JSON completo del Service Account en una sola línea
# En desarrollo local: también podés colocar el archivo firebase-key.json en la raíz
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com

# Pasarela de Pagos Mercado Pago (Access Token de Producción o Sandbox)
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Cloudinary (Widget de subida para el panel de administración)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dyskgncu8
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=optica_danny

# Modo Construcción / Lanzamiento ("true" = activo con logo breathe y pantalla de apertura; "false" = web pública directa)
NEXT_PUBLIC_MAINTENANCE_MODE=true
